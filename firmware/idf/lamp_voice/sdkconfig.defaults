# 控制台走板载 USB-Serial-JTAG（和设备管理器里的 COM 口是同一个）
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# YD-ESP32-S3-N16R8：16 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y

CONFIG_FREERTOS_HZ=1000

# ---- LAMP voice link ----
# SSID 留空时固件会扫描并打印附近 AP，方便先看清环境再填
CONFIG_LAMP_WIFI_SSID=""
CONFIG_LAMP_WIFI_PASS=""
CONFIG_LAMP_SERVER_HOST="10.1.41.14"
CONFIG_LAMP_SERVER_PORT=8766
