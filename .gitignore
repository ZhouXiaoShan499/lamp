# 整片 flash 备份（16 MB，含 MicroPython 原厂固件）
firmware/backup/

# Vosk 语音识别模型（体积大，走外部下载/存储）+ 测试音频
server/models/
*.wav

# 服务端调试产物（录制的音频/截图）
server/debug/

# 探测/临时文件
_tmp_*.txt
.dsh-write-probe.txt
