# PlatformIO 构建产物
.pio/
.pioenvs/
.piolibdeps/
*.elf
*.map

# 本地凭据（WiFi 密码 / 电脑局域网 IP），从 secrets.h.example 复制
firmware/include/secrets.h

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# IDE / 编辑器
.vscode/
.idea/
*.swp

# 操作系统
Thumbs.db
.DS_Store
desktop.ini

# ESP-IDF 构建产物（firmware/idf 下的探针/客户端）
build/
firmware/idf/**/build/
firmware/idf/**/sdkconfig
